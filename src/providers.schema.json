{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Mahiron-hq/ai-dns/main/src/providers.schema.json",
  "title": "AI-DNS provider catalog",
  "type": "object",
  "required": ["schemaVersion", "updated", "providers"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "providers": {
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "#/$defs/provider" }
    },
    "retiredIpv4": {
      "description": "Addresses that earlier releases could have applied. They are not tested, only recognised during rollback.",
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/ipv4" }
    }
  },
  "$defs": {
    "ipv4": {
      "type": "string",
      "pattern": "^(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3}$"
    },
    "hostname": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9-]{2,63}$"
    },
    "provider": {
      "type": "object",
      "required": ["id", "name", "ipv4"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "website": { "type": "string", "pattern": "^https://" },
        "hosts": {
          "description": "Names that resolve to the provider's current resolver addresses.",
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/hostname" }
        },
        "ipv4": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/ipv4" }
        },
        "doh": {
          "description": "DNS-over-HTTPS templates served on the same addresses as plain DNS.",
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^https://[a-z0-9.-]+/[^\\s?#{}]*$" }
        }
      }
    }
  }
}
